+static uint64_t get_sad_ob_simd(AVMotionEstContext *me_ctx, int x, int y, int x_mv, int y_mv)
+{
+    uint8_t *data_ref = me_ctx->data_ref;
+    uint8_t *data_cur = me_ctx->data_cur;
+    int linesize_ref = me_ctx->linesize_ref;
+    int linesize_cur = me_ctx->linesize_cur;
+    int x_min = me_ctx->x_min + me_ctx->mb_size / 2;
+    int x_max = me_ctx->x_max - me_ctx->mb_size / 2;
+    int y_min = me_ctx->y_min + me_ctx->mb_size / 2;
+    int y_max = me_ctx->y_max - me_ctx->mb_size / 2;
+    int mv_x = x_mv - x;
+    int mv_y = y_mv - y;
+    uint64_t sad = 0;
+
+    x = av_clip(x, x_min, x_max);
+    y = av_clip(y, y_min, y_max);
+    x_mv = av_clip(x_mv, x_min, x_max);
+    y_mv = av_clip(y_mv, y_min, y_max);
+
+    /* Keep the original clipped windows and the pre-clip displacement penalty. */
+    sad = me_ctx->mc_sad(data_cur + x - me_ctx->mb_size / 2 +
+                        (y - me_ctx->mb_size / 2) * linesize_cur, linesize_cur,
+                        data_ref + x_mv - me_ctx->mb_size / 2 +
+                        (y_mv - me_ctx->mb_size / 2) * linesize_ref, linesize_ref);
+
+    return sad + (FFABS(mv_x - me_ctx->pred_x) + FFABS(mv_y - me_ctx->pred_y)) * COST_PRED_SCALE;
+}
