+/* ---- mci_accel bit 32: the bidirectional EPZS search as a wavefront (n-frame tests/probes/mci_fused/PLAN.md) ----
+ * Of the pair being searched, a block reads only three vectors: its left, top and top-right neighbours'
+ * (mv_table[0]); the other predictors come from earlier pairs' tables, which nothing writes meanwhile. So block x of
+ * row y may be searched once row y-1 has finished block x+1. Rows are claimed in order, per direction; each job has
+ * its own scratch context; progress is published and awaited a chunk of blocks at a time. Every block reads the values it reads in the serial order, so every vector is the same. */
+#define MCI_WAVE_CHUNK 8   /* blocks searched between two looks at the row above (a block is a few hundred ns) */
+#define MCI_WAVE_LAG   1   /* blocks of the row above needed beyond a chunk's last block: its top-right */
+
+typedef struct MCWaveData {
+    AVMotionEstContext base;    ///< the context as the pair begins
+    AVMotionEstContext last;    ///< the context as the serial order leaves it: after direction 1's last block
+    atomic_int next_row[2];     ///< the next unclaimed row of each direction
+    atomic_int *done;           ///< blocks finished in each row, [direction * b_height + row]
+} MCWaveData;
+
+static int search_wave_jobs(AVFilterContext *ctx, void *arg, int jobnr, int nb_jobs)
+{
+    MIContext *mi_ctx = ctx->priv;
+    MCWaveData *td = arg;
+    AVMotionEstContext me = td->base;
+    const int bw = mi_ctx->b_width, bh = mi_ctx->b_height;
+    int pass, mb_x;
+
+    for (pass = 0; pass < 2; pass++) {
+        const int dir = (jobnr + pass) & 1;   /* jobs start on alternate directions; one job does 0 then 1 */
+
+        me.linesize_cur = mi_ctx->frames[2].avf->linesize[0];
+        me.linesize_ref = mi_ctx->frames[dir ? 3 : 1].avf->linesize[0];
+        me.data_cur = mi_ctx->frames[2].avf->data[0];
+        me.data_ref = mi_ctx->frames[dir ? 3 : 1].avf->data[0];
+
+        for (;;) {
+            const int mb_y = atomic_fetch_add(&td->next_row[dir], 1);
+            atomic_int *mine, *above;
+
+            if (mb_y >= bh)
+                break;
+            mine  = &td->done[dir * bh + mb_y];
+            above = mb_y ? mine - 1 : NULL;
+            for (mb_x = 0; mb_x < bw; mb_x++) {
+                if (above && !(mb_x % MCI_WAVE_CHUNK)) {
+                    const int need = FFMIN(mb_x + MCI_WAVE_CHUNK + MCI_WAVE_LAG, bw);
+                    int spins = 0;
+                    while (atomic_load(above) < need)
+                        if (++spins > 256)
+                            sched_yield();
+                }
+                search_mv_context(mi_ctx, &me, mi_ctx->frames[2].blocks, mb_x, mb_y, dir);
+                if (!((mb_x + 1) % MCI_WAVE_CHUNK) || mb_x == bw - 1)
+                    atomic_store(mine, mb_x + 1);
+            }
+            if (dir == 1 && mb_y == bh - 1)
+                td->last = me;
+        }
+    }
+    return 0;
+}
